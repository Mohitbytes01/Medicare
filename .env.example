# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# N8N_WEBHOOK_URL: Optional webhook endpoint for automated SMS reminders and pharmacy portal logging.
N8N_WEBHOOK_URL=""

# META WHATSAPP CLOUD API (Free Test WhatsApp Business Number from developers.facebook.com)
# WHATSAPP_ACCESS_TOKEN: Temporary or permanent Graph API token from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID: Phone Number ID for the Free Test Number in Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN: Webhook verify token used when registering /api/whatsapp/webhook in Meta Developer Portal
WHATSAPP_VERIFY_TOKEN="verimed_whatsapp_verify_2026"
# VITE_WHATSAPP_BOT_NUMBER: Display phone number of the Meta Test WhatsApp Bot (e.g. +1 555 092 8471)
VITE_WHATSAPP_BOT_NUMBER=""

# MONETIZATION: Adsterra Smartlink, Google AdSense & Pharmacy Affiliate Tracking
# VITE_ADSTERRA_SMARTLINK_URL: Your Adsterra Smartlink / Direct Link URL
VITE_ADSTERRA_SMARTLINK_URL="https://asiafilm.org/4/1aa8f7a6481d1f8762a00d2cfe07f570"
# VITE_ADSENSE_CLIENT_ID: Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
VITE_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_SLOT_SIDEBAR=""
VITE_ADSENSE_SLOT_HORIZONTAL=""
# PHARMACY_AFFILIATE_TAG: Affiliate tracking ID for Tata 1mg, PharmEasy, Netmeds & Apollo 24|7 links
PHARMACY_AFFILIATE_TAG="verimed_partner"


